source_lang: en
target_lang: ru
# target_lang_name: Russian  # auto-derived from target_lang if omitted

providers:
  text:
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"
  image:
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"

chunker:
  target_words: 2000
  overlap_paragraphs: 1

translate:
  parallelism: 1    # concurrent chunks; raise to 4-8 for speedup.

models:
  glossary:   anthropic/claude-sonnet-4.6
  translate:  anthropic/claude-sonnet-4.6
  judge:      anthropic/claude-haiku-4.5
  reflect:    anthropic/claude-sonnet-4.6
  proofread:  anthropic/claude-haiku-4.5
  style:      anthropic/claude-sonnet-4.6
  verify:     anthropic/claude-sonnet-4.6
  repair:     anthropic/claude-sonnet-4.6

reflection:
  # Порог 3, а не 2: при 2 отбор почти случаен — оценщик, прогнанный дважды по
  # одному тексту, отбирает 3 общих фрагмента из 17. При 3 общих 28 из 36.
  # Сама стадия оправдывает расход: на плохих фрагментах она сняла 53
  # процитированных дефекта из 55 против 24 у остальной цепочки.
  trigger_score: 3

pauses:
  after_glossary: true
  after_translate: true

stages:
  proofread: true
  style: true
  verify: true

retry:
  max_attempts: 5
  backoff_base: 2.0

notifications:
  enabled: true
  provider: telegram

cost:
  hard_limit_usd: 50.0

repair:
  # Точечная починка замечаний оценщика: правится только названная им фраза,
  # остальной абзац не трогается.
  #
  # Оценщик выдаёт шесть категорий: grammar, accuracy, naturalness, register,
  # glossary, markup. Включены три, где исправление сводится к подстановке.
  # Замер на «Bear Head» (36 кандидатов через привратника): отклонено 3 из 11
  # у grammar, 7 из 20 у accuracy, 4 из 5 у glossary — поэтому accuracy в
  # списке, а glossary нет. register и naturalness автоматике не по зубам.
  enabled: true
  categories: [grammar, markup, accuracy]

reader_notes:
  enabled: true
  types: [concept, term]
  scope: first-in-book  # first-in-chapter | first-in-book | all
