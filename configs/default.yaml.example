source_lang: en
target_lang: ru
# target_lang_name: Russian  # auto-derived from target_lang if omitted

providers:
  text:
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"
  image:
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"

chunker:
  target_words: 1200
  overlap_paragraphs: 1

translate:
  parallelism: 1    # concurrent chunks; raise to 4-8 for speedup.

models:
  glossary:   anthropic/claude-sonnet-4.6
  translate:  anthropic/claude-sonnet-4.6
  judge:      anthropic/claude-haiku-4.5
  reflect:    anthropic/claude-sonnet-4.6
  proofread:  anthropic/claude-haiku-4.5
  style:      anthropic/claude-sonnet-4.6
  verify:     anthropic/claude-sonnet-4.6

reflection:
  trigger_score: 3

pauses:
  after_glossary: true
  after_translate: true

stages:
  proofread: true
  style: true
  verify: true

retry:
  max_attempts: 5
  backoff_base: 2.0

notifications:
  enabled: true
  provider: telegram

cost:
  hard_limit_usd: 50.0

reader_notes:
  enabled: true
  types: [concept, term]
  scope: first-in-book  # first-in-chapter | first-in-book | all
