# Example: text/translation stages via kiro-gateway, glossary and image via OpenRouter.
#
# Copy this to configs/default.yaml (or use --config path) to route
# translation stages through kiro-gateway while keeping OpenRouter for
# glossary extraction (needs full book context, no truncation) and cover
# image generation.
#
# Requires:
#   - kiro-gateway running on localhost:9000
#   - KIRO_GATEWAY_API_KEY set in .env (your PROXY_API_KEY from kiro-gateway)
#   - OPENROUTER_API_KEY set in .env (for glossary + cover image generation)

source_lang: en
target_lang: ru

providers:
  text:                       # default for all text stages (translate, judge, reflect, ...)
    base_url: "http://localhost:9000/v1"
    api_key_env: "KIRO_GATEWAY_API_KEY"
    # Ответ шлюза ограничен примерно 23 КБ, и размышление делит этот бюджет
    # с самим ответом. Шлюз об обрыве не предупреждает: finish_reason приходит
    # "stop" даже когда ответ пустой. Отсюда предупреждение в лог при
    # приближении к пределу. Подробности и замеры — в
    # docs/design/2026-08-03-judge-repair-stage-and-reasoning-on-gateway.md §4.
    max_response_bytes: 23000
  glossary:                   # whole book -> needs large context without truncation
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"
  judge:                   # whole book -> needs large context without truncation
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"
  reflect:                   # whole book -> needs large context without truncation
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"
  proofread:                   # whole book -> needs large context without truncation
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"
  image:
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"

chunker:
  target_words: 1200
  overlap_paragraphs: 1

translate:
  parallelism: 1

# Model names must match your provider's format.
# - kiro-gateway: short names without prefix (claude-sonnet-4.6)
# - OpenRouter: anthropic/ prefix required (anthropic/claude-sonnet-4.6)
models:
  glossary:   anthropic/claude-sonnet-4.6
  translate:  claude-sonnet-4.6
  judge:      anthropic/claude-haiku-4.5
  reflect:    anthropic/claude-sonnet-4.6
  proofread:  anthropic/claude-haiku-4.5
  style:      claude-sonnet-4.6
  verify:     claude-sonnet-4.6

reflection:
  trigger_score: 3

pauses:
  after_glossary: true
  after_translate: true

stages:
  proofread: true
  style: true
  verify: true

retry:
  max_attempts: 5
  backoff_base: 2.0

notifications:
  enabled: true
  provider: telegram

cost:
  hard_limit_usd: 50.0

reader_notes:
  enabled: true
  types: [concept, term]
  scope: first-in-book
