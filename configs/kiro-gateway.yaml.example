# Пример: все текстовые стадии идут через локальный kiro-gateway, а через
# OpenRouter — только обложка.
#
# Скопируйте этот файл в configs/default.yaml (или укажите путь через --config).
#
# Раскладка получена замерами 2026-11-01, подробности — в
# docs/design/2026-11-01-native-reasoning-on-gateway.md. Прежняя причина держать
# часть стадий на OpenRouter отпала: предел около 23 КБ на размер ответа больше не
# воспроизводится (целиком пришёл ответ на 70 КБ), а настоящее рассуждение модели
# теперь работает и через шлюз.
#
# Что нужно для работы:
#   - kiro-gateway с поддержкой настоящего рассуждения, запущенный на localhost:9000;
#   - KIRO_GATEWAY_API_KEY в файле .env (это ваш PROXY_API_KEY из kiro-gateway);
#   - OPENROUTER_API_KEY в .env (только для обложки);
#   - FAKE_REASONING=false в настройках самого шлюза. Подделанное рассуждение
#     подмешивает служебные метки в запрос к моделям, у которых нет настоящего,
#     и на переводе съедает ответ целиком.

source_lang: en
target_lang: ru

providers:
  # Значение по умолчанию для всех текстовых стадий.
  text:
    base_url: "http://localhost:9000/v1"
    api_key_env: "KIRO_GATEWAY_API_KEY"

  image:
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"

chunker:
  # Размер оставлен прежним, хотя предел шлюза, ради которого его уменьшали, больше
  # не воспроизводится: смена значения обнуляет кэш, а выигрыш не доказан.
  # Менять это значение задним числом дорого: сдвигаются границы фрагментов, и весь
  # накопленный перевод в кэше обесценивается.
  target_words: 1200
  overlap_paragraphs: 1

translate:
  # Отсюда значение берут все стадии (через min(parallelism, 8)). При замерах
  # одновременно шло до 14 запросов, отказов от шлюза не было. Если шлюз начнёт
  # срываться, первым делом верните 1.
  parallelism: 8

# Имена моделей должны быть записаны в формате своего провайдера:
#   - kiro-gateway — короткое имя без приставки (claude-sonnet-5.5);
#   - OpenRouter — с приставкой anthropic/ (anthropic/claude-sonnet-5.5).
#
# Везде Sonnet, а не Haiku, по сравнению на 12 фрагментах. Перевод у Haiku 5.5 при
# проверке вслепую вышел с вдвое большим числом ошибок. Корректор на Sonnet дал 18
# полезных правок и ни одной вредной против 10 и 5 у Haiku, а оценщик точнее и быстрее.
# Haiku 4.5 на шлюзе не подойдёт: Kiro не принимает для него настройки рассуждения.
models:
  glossary:   claude-sonnet-5.5
  translate:  claude-sonnet-5.5
  judge:      claude-sonnet-5.5
  reflect:    claude-sonnet-5.5
  proofread:  claude-sonnet-5.5
  style:      claude-sonnet-5.5
  verify:     claude-sonnet-5.5
  repair:     claude-sonnet-5.5

# Уровень рассуждения по стадиям. Заменяет reasoning_effort из заголовка промпта,
# и только в этой конфигурации: там значения подобраны под OpenRouter.
# Смена уровня заставляет стадию выполниться заново: уровень входит в ключ кэша.
#
# На шлюзе уровень значит не то, что подсказывает название:
#   - none на Sonnet 5.5 не отключает рассуждение: модель этого не умеет и работает
#     на своём обычном уровне;
#   - low снижает старательность всего ответа, а не только рассуждения;
#   - xhigh и max на длинных ответах опасны: Haiku 5.5 при них вернул на перевод
#     пустой ответ, а Sonnet 5 при max думал по 10 минут над одним фрагментом.
#
# Значения подобраны сравнением на 12 фрагментах «Bear Head», оценка вслепую:
reasoning:
  glossary:   high    # 110 статей; low давал вдвое меньше
  translate:  medium  # по цене как low; лучший в 7 фрагментах из 12, глоссарий соблюдён
  judge:      high    # 61% настоящих замечаний против 47% при low
  reflect:    medium  # по форме это перевод; при пороге 1 стадия почти не запускается
  proofread:  high    # 18 полезных правок вне внесённых ошибок против 11 при low
  style:      high    # вредных правок 4 из 40 против 12 из 52 при low
  verify:     low     # находит столько же, что и high, вреда столько же, дешевле и быстрее
  repair:     high    # пропускает 44 настоящих исправления из 50 против 38 при low

reflection:
  # Порог 1, потому что рефлексия с новым оценщиком не окупается. Оценка отражает худший
  # дефект, а новый оценщик находит его почти везде: двойку получают 7 фрагментов из 12.
  # Итоговый текст после всех стадий с рефлексией и без неё сравнили вслепую на этих
  # семи фрагментах: лучше с ней 4, без неё 3, смысловых ошибок поровну (12 и 12). При этом
  # она переписывает 87% абзацев и стоит около 1,2 кредита на фрагмент.
  # Оценка 1 на проверке не встретилась ни разу, поэтому стадия фактически выключена.
  # Порог подобран под этого оценщика: при смене его модели или уровня измерьте заново.
  trigger_score: 1

pauses:
  after_glossary: true
  after_translate: true

stages:
  proofread: true
  style: true
  verify: true

retry:
  max_attempts: 5
  backoff_base: 2.0

notifications:
  enabled: true
  provider: telegram

cost:
  hard_limit_usd: 50.0

repair:
  # Категории замечаний оценщика, которые чинит стадия. Список получен замером,
  # а не выбран: на «Bear Head» через привратника прошло 36 кандидатов, и
  # отклонено было 3 из 11 у grammar, 7 из 20 у accuracy, 4 из 5 у glossary.
  # Поэтому accuracy включена — она ведёт себя как грамматика и несёт больше
  # всего дефектов, — а glossary убрана: её замечания чаще суждение (переставить
  # имя, заменить придуманный термин), чем подстановка.
  # register и naturalness автоматике не по зубам и не включаются вовсе.
  enabled: true
  categories: [grammar, markup, accuracy]

reader_notes:
  enabled: true
  types: [concept, term]
  scope: first-in-book
