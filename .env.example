# OpenRouter API key (used by default for all providers)
OPENROUTER_API_KEY=

# Optional: separate provider for text tasks (e.g. kiro-gateway)
# Configure in configs/default.yaml → providers.text.api_key_env
# KIRO_GATEWAY_API_KEY=

# Telegram notifications (optional; leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: attribution headers for OpenRouter leaderboards
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=book-translator
